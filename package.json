{
  "name": "clipforge",
  "version": "0.1.0",
  "description": "A lightweight free video editor",
  "author": "ClipForge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.clipforge.editor",
    "productName": "ClipForge",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "captions.js",
      "home.js", "style.css", "icon.png", "package.json"],
    "extraResources": [
      { "from": "vendor", "to": "vendor" },
      { "from": "models", "to": "models" }
    ],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "afterPack": "build-icon.cjs",
    "win": { "target": "nsis", "icon": "icon.ico", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipForge",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}
